# Copy these names/values into the API service's Production environment in Vercel.
# Replace every REPLACE_* value with a generated secret or provider-issued value.
NODE_ENV=production
WEB_APP_URL=https://YOUR_WEB_DOMAIN
PUBLIC_API_URL=https://YOUR_WEB_DOMAIN/api
TRUST_PROXY_HOPS=1
SCHEDULER_INTERVAL_SECONDS=0

# Supabase Session pooler (port 5432), not the IPv6-only direct database host.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_PREPARE=true
DATABASE_POOL_MAX=2

# Standard Redis protocol URL supported by ioredis; Redis Cloud/Upstash TCP endpoint.
# Do not use a REST URL (https://...) or a REST token URL.
REDIS_URL=rediss://default:REPLACE_WITH_PASSWORD@YOUR_REDIS_HOST:6379

# Generate independent random values; never reuse SESSION_SECRET for document encryption.
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
INTEGRATIONS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_16_CHARACTERS

# Production requires SMTP (the outbox transport is intentionally rejected).
MAIL_TRANSPORT=smtp
MAIL_FROM=Club Manager <no-reply@example.com>
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# Optional Discord OAuth. Leave all three unset unless enabling Discord sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Optional Google Calendar integration. Set all three values together when enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional AI. For a local model, use a secured HTTPS endpoint reachable from Vercel;
# localhost on your laptop is not reachable by the deployed API.
LLM_PROVIDER=local
LLM_BASE_URL=https://YOUR_SECURED_MODEL_HOST/v1
LLM_MODEL=llama3.2
LLM_API_KEY=REPLACE_WITH_MODEL_SERVER_KEY
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Optional alternatives/overrides. Keep unset unless intentionally routing data there.
ANTHROPIC_API_KEY=
QWEN_API_KEY=
AI_PROVIDER_OVERRIDES=

# Optional operational settings
ORG_SIGNUP_ENABLED=true
COOKIE_SECURE=true
FX_PROVIDER=frankfurter
ENABLE_API_DOCS=false
