# Copy to apps/api/.env for local development. Never commit real values.
# Every value marked REQUIRED must be supplied by you; nothing secret has a default.

NODE_ENV=development
PORT=4000

# REQUIRED. Supabase: Project Settings > Database > Connection string.
# Use the direct connection or the SESSION pooler (port 5432). If you use the TRANSACTION
# pooler (port 6543), also set DATABASE_PREPARE=false.
DATABASE_URL=
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# REQUIRED. Upstash / Railway Redis URL (rediss:// for TLS).
REDIS_URL=

# REQUIRED. Public URL of the web app (Vercel). Used for links in emails and Origin checks.
WEB_APP_URL=http://localhost:3000
# Optional extra allowed origins, comma separated.
ALLOWED_ORIGINS=

# REQUIRED. At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_IDLE_TTL_HOURS=72
SESSION_ABSOLUTE_TTL_DAYS=30
# Leave unset in production (defaults to true). Set false only for local http.
COOKIE_SECURE=false
# Number of proxies in front of the API (e.g. 2 for Vercel rewrite + Railway/Fly edge).
# Verify after deploying: rate limits key on the client IP derived from this.
TRUST_PROXY_HOPS=0

# Self-service creation of NEW organizations (each signup becomes the first Owner).
ORG_SIGNUP_ENABLED=true
# Swagger UI at /docs. Defaults to on outside production.
ENABLE_API_DOCS=

# Optional: Discord sign-in. All three or none. Create an app at
# https://discord.com/developers/applications and register the redirect below.
# The redirect must go through the WEB app origin: https://<web-app>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Mail. "outbox" (dev/test only: stores messages in the database) or "smtp".
# Production REQUIRES smtp; the provider has not been chosen yet (see DECISIONS.md).
MAIL_TRANSPORT=outbox
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Exchange rates (Phase 2). "frankfurter" (default: free, no API key, https://frankfurter.dev)
# or "none" (no automatic rates: users type the rate for every foreign-currency record).
# Review the provider's terms before production (see DECISIONS.md).
FX_PROVIDER=frankfurter
FX_PROVIDER_URL=https://api.frankfurter.dev

# PDF exports run headless Chromium. Unset: the bundled @sparticuz/chromium build is used.
# The Docker image installs Debian's chromium and sets this to /usr/bin/chromium.
# @sparticuz/chromium is Linux-only; on Windows, set this to a local Chrome/Edge executable.
CHROMIUM_EXECUTABLE_PATH=

# Anthropic API: the Custom Clause Assistant (contracts) and the five AI assistants.
# Optional: leave the key empty and the assistants show "not configured"; everything else works.
# Create a key at https://platform.claude.com (Settings > API keys). Never commit it.
ANTHROPIC_API_KEY=
# Model ID from https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=120000
# Web search for the General, Offer Optimizer and Player Analyst assistants: on | off.
# Off by default (Phase 6). Uses Anthropic's web search tool (billed per search on top of
# tokens). Only Anthropic offers it here: assistants routed to Qwen3 never search the web.
ASSISTANT_WEB_SEARCH=off

# Phase 6: a second AI provider. Qwen3 (open weights, Apache 2.0) through DeepInfra's
# OpenAI-compatible API (see DECISIONS.md for why DeepInfra and this model).
# Optional: leave the key empty and anything routed to Qwen shows "not configured".
# Create a key in the DeepInfra dashboard (https://deepinfra.com, API keys). Never commit it.
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
QWEN_API_URL=https://api.deepinfra.com/v1/openai
QWEN_TIMEOUT_MS=120000
# Which provider answers: anthropic (default) | qwen. No silent fallback between them.
AI_PROVIDER_DEFAULT=anthropic
# Per-feature overrides, comma separated, e.g. player_analyst=qwen,email=qwen
# Features: clause_assistant, general, formal_message, email, offer_optimizer, player_analyst
AI_PROVIDER_OVERRIDES=

# ---------- Phase 6: meetings and integrations ----------

# How often reminders and integration jobs run (seconds). 0 turns the scheduler off
# (e.g. on extra API replicas; jobs are claimed with row locks, so several workers are safe).
SCHEDULER_INTERVAL_SECONDS=30
# Public URL where Google, Notion and webhook senders reach this API.
# Default: WEB_APP_URL + /api (the Next.js proxy). Must be https in production.
PUBLIC_API_URL=
# Key for encrypting integration secrets (OAuth tokens, Notion tokens, webhook secrets).
# At least 32 characters; generate with: openssl rand -base64 48
# Unset: derived from SESSION_SECRET (rotating SESSION_SECRET then breaks stored secrets).
INTEGRATIONS_ENCRYPTION_KEY=

# Optional: Google Calendar. All three or none. Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials, enable the Google Calendar API, and
# register the redirect below (through the WEB app origin).
# Scope requested: https://www.googleapis.com/auth/calendar.events (sensitive scope:
# Google's verification is needed before more than 100 users can connect).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Overridable only for tests.
GOOGLE_API_URL=https://www.googleapis.com
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# Notion: each organization pastes its own internal-integration secret in the app; nothing to
# set here. The API version is pinned; change it only after testing the new version.
NOTION_API_URL=https://api.notion.com
NOTION_VERSION=2026-03-11

# Outgoing webhooks to private/loopback addresses are refused (SSRF protection).
# true only for local development; refused in production.
WEBHOOK_ALLOW_PRIVATE_URLS=false
INTEGRATIONS_TIMEOUT_MS=20000

# ---------- ID-document patch (signing) ----------

# REQUIRED in production. Encrypts signers' identity documents (passport / national ID photos)
# at rest. At least 32 characters; generate with: openssl rand -base64 48
# Keep it like a backup key: if it is lost, the stored documents can't be read.
# Unset outside production: derived from SESSION_SECRET.
DOCUMENT_ENCRYPTION_KEY=

# ---------- Vercel (one project: web + api services, see vercel.json) ----------

# A daily Vercel Cron Job calls /api/internal/scheduler/tick with
# "Authorization: Bearer <CRON_SECRET>" as a backstop to the scheduler worker. At least 16
# characters. Unset: the tick route is closed. Not needed when the API runs as a long-lived server.
CRON_SECRET=
# The scheduler worker (apps/api/src/worker.ts; a Vercel Daemon on the Hobby plan) ticks this often.
WORKER_INTERVAL_SECONDS=60
# On Vercel (VERCEL=1) these default automatically unless set here:
#   WEB_APP_URL                 -> this deployment's own URL (production URL in production,
#                                  branch/deployment URL in previews); set it for a custom domain
#   TRUST_PROXY_HOPS            -> 1 (Vercel's edge sets X-Forwarded-For to the client IP)
#   SCHEDULER_INTERVAL_SECONDS  -> 0 (functions don't run between requests; the worker ticks instead)
