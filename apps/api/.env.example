# Copy to apps/api/.env for local development. Never commit real values.
# Every value marked REQUIRED must be supplied by you; nothing secret has a default.

NODE_ENV=development
PORT=4000

# REQUIRED. Supabase: Project Settings > Database > Connection string.
# Use the direct connection or the SESSION pooler (port 5432). If you use the TRANSACTION
# pooler (port 6543), also set DATABASE_PREPARE=false.
DATABASE_URL=
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# REQUIRED. Upstash / Railway Redis URL (rediss:// for TLS).
REDIS_URL=

# REQUIRED. Public URL of the web app (Vercel). Used for links in emails and Origin checks.
WEB_APP_URL=http://localhost:3000
# Optional extra allowed origins, comma separated.
ALLOWED_ORIGINS=

# REQUIRED. At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_IDLE_TTL_HOURS=72
SESSION_ABSOLUTE_TTL_DAYS=30
# Leave unset in production (defaults to true). Set false only for local http.
COOKIE_SECURE=false
# Number of proxies in front of the API (e.g. 2 for Vercel rewrite + Railway/Fly edge).
# Verify after deploying: rate limits key on the client IP derived from this.
TRUST_PROXY_HOPS=0

# Self-service creation of NEW organizations (each signup becomes the first Owner).
ORG_SIGNUP_ENABLED=true
# Swagger UI at /docs. Defaults to on outside production.
ENABLE_API_DOCS=

# Optional: Discord sign-in. All three or none. Create an app at
# https://discord.com/developers/applications and register the redirect below.
# The redirect must go through the WEB app origin: https://<web-app>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Mail. "outbox" (dev/test only: stores messages in the database) or "smtp".
# Production REQUIRES smtp; the provider has not been chosen yet (see DECISIONS.md).
MAIL_TRANSPORT=outbox
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
