{
  "name": "@esports/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "platform-admin": "bun src/cli/platform-admin.ts",
    "docs:permissions": "bun src/cli/generate-permissions-doc.ts"
  },
  "dependencies": {
    "@esports/shared": "workspace:*",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/aref-ruqaa": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/swagger": "^12",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/functions": "^3.10.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.1",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12",
    "@types/bun": "^1.4.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3"
  }
}
