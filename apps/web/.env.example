# Copy to apps/web/.env.local for local development (or set in Vercel project settings).

# REQUIRED. Base URL of the NestJS API, reached server-side by the /api/* rewrite.
# Local: http://localhost:4000   Production: https://<your-api>.up.railway.app (or fly.dev)
API_URL=http://localhost:4000

# Time zone used for server-rendered dates.
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Asia/Riyadh
