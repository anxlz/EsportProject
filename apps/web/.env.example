# Copy to apps/web/.env.local for local development (or set in Vercel project settings).

# Base URL of the NestJS API, reached server-side by the /api/* rewrite in next.config.ts.
# Local: http://localhost:4000   API hosted elsewhere: https://<your-api>.up.railway.app (or fly.dev)
# Not used on Vercel when web and API are one project with two services (vercel.json routes
# /api/* to the API service directly).
API_URL=http://localhost:4000

# Time zone used for server-rendered dates.
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Asia/Riyadh
