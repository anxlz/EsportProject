{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "cd ../.. && bun install --frozen-lockfile && bun run --cwd packages/shared build",
      "devCommand": "bun --watch src/main.ts",
      "functions": {
        "src/main.ts": {
          "includeFiles": "{node_modules/@{fontsource/*,nestjs/platform-express,sparticuz/chromium,ioredis/commands}/**,node_modules/{ioredis,cluster-key-slot,debug,denque,redis-errors,standard-as-callback,tslib,puppeteer-core}/**,assets/fonts/saudi-riyal/*.woff2}"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/scheduler/tick",
      "schedule": "0 3 * * *"
    }
  ],
  "daemons": {
    "scheduler": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      }
    }
  }
}
